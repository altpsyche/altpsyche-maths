{
  "name": "@altpsyche/maths",
  "version": "3.3.0",
  "description": "The mathematics AltPsyche's figures are drawn from: vectors, matrices, curves, and a value walked over time.",
  "license": "MIT",
  "author": "Siva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altpsyche/altpsyche-maths.git"
  },
  "homepage": "https://github.com/altpsyche/altpsyche-maths",
  "bugs": "https://github.com/altpsyche/altpsyche-maths/issues",
  "keywords": [
    "maths",
    "animation",
    "easing",
    "keyframes",
    "vector",
    "matrix"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "font/LICENSE-NotoSans.txt",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "demos": "tsc -p tsconfig.demos.json && node .demos/demos/write.js",
    "gate:record": "npm run build && node gates/record.mjs",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "check:vocab": "node gates/vocab.mjs",
    "prepack": "npm run build",
    "gate:gpu": "npm run build && node gates/gpu.mjs",
    "gate:floor": "node gates/floor.mjs",
    "font": "node font/build.mjs"
  },
  "devDependencies": {
    "@altpsyche/engine": "^0.6.1",
    "@types/node": "^20.19.43",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mathjax-full": "^3.2.1",
    "mediabunny": "^1.56.1"
  },
  "peerDependencies": {
    "@altpsyche/engine": "^0.6.0"
  }
}
